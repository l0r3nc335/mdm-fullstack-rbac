DATABASE_URL="postgresql://rbac:rbac@localhost:5433/rbac?schema=public"
JWT_SECRET="rbac-demo-jwt-secret-change-in-production"
JWT_EXPIRES_IN="8h"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Password hashing (bcrypt cost factor; 12 is production-grade)
BCRYPT_ROUNDS=12

# Rate limiting (set RATE_LIMIT_ENABLED=false only for automated tests)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# Set to true behind nginx / a reverse proxy so client IPs are correct
TRUST_PROXY=false
